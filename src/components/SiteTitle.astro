---
/* 사이드바(인덱스 패널) 열고 닫기 토글.
 *
 * 버튼이 사이드바 안에 있으면 닫는 순간 같이 사라진다 — 헤더 제목 옆(SiteTitle
 * 오버라이드)에 두어 닫힌 상태에서도 다시 열 수 있게 한다. 상태는 html 의
 * data-sidebar 로만 표현하고 레이아웃은 전부 CSS 가 처리한다
 * (src/styles/sidebar-toggle.css).
 */
import Default from '@astrojs/starlight/components/SiteTitle.astro';
---

<button type="button" class="sidebar-toggle" aria-controls="starlight__sidebar" aria-expanded="true">
	<svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
		<rect x="3" y="4" width="18" height="16" rx="2"></rect>
		<line x1="9" y1="4" x2="9" y2="20"></line>
	</svg>
	<span class="sr-only">인덱스 패널 열기/닫기</span>
</button>

<Default><slot /></Default>

<script is:inline>
	(() => {
		const KEY = 'sl-sidebar-collapsed';
		const root = document.documentElement;

		const apply = (closed) => {
			root.dataset.sidebar = closed ? 'closed' : 'open';
			for (const btn of document.querySelectorAll('.sidebar-toggle')) {
				btn.setAttribute('aria-expanded', String(!closed));
			}
		};

		let stored = null;
		try {
			stored = localStorage.getItem(KEY);
		} catch {}
		apply(stored === '1');

		document.addEventListener('click', (event) => {
			const btn = event.target instanceof Element && event.target.closest('.sidebar-toggle');
			if (!btn) return;
			const closed = root.dataset.sidebar !== 'closed';
			try {
				localStorage.setItem(KEY, closed ? '1' : '0');
			} catch {}
			apply(closed);
		});
	})();
</script>
