---
/* 목차 패널에서만 제목 배지를 감춘다 — 이유는 src/lib/strip-heading-badges.mjs 주석에.

   목차 오버라이드를 원하는 플러그인이 둘(starlight-quiz, starlight-heading-badges)인데
   Starlight 는 한 컴포넌트에 하나만 걸 수 있어 먼저 등록한 quiz 가 차지하고 있었다.
   그래서 배지 복원이 아예 돌지 않았고, 직렬화 문자열이 목차에 그대로 노출됐다.
   여기서 배지를 걷어낸 뒤 quiz 쪽 오버라이드를 그대로 렌더한다 — 퀴즈 진행률 위젯은
   살고, 목차에는 배지가 남지 않는다. 본문 제목의 배지는 별도 rehype 단계라 그대로다. */
import QuizTableOfContents from 'starlight-quiz/overrides/TableOfContents.astro';
import { stripHeadingBadges } from '../lib/strip-heading-badges.mjs';

stripHeadingBadges(Astro.locals.starlightRoute.toc);
---

<QuizTableOfContents />
